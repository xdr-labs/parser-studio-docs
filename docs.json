{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Parser Studio",
  "description": "Beginner-first security log parsing: paste, analyze, review field mappings, troubleshoot and create reviewed parser drafts.",
  "colors": {
    "primary": "#1F59E0",
    "light": "#2982E8",
    "dark": "#5B8CFF"
  },
  "navigation": {
    "groups": [
      {
        "group": "Start Here",
        "pages": [
          "index",
          "quickstart",
          "choose-workflow"
        ],
        "icon": "rocket"
      },
      {
        "group": "Auto Parser",
        "pages": [
          "workflows/auto-parser",
          "workflows/review-fields",
          "workflows/map-fields",
          "workflows/create-and-download"
        ],
        "icon": "wand-magic-sparkles"
      },
      {
        "group": "ChatGPT Assisted Parser",
        "pages": [
          "workflows/chatgpt-assisted",
          "workflows/holdout-validation"
        ],
        "icon": "comments"
      },
      {
        "group": "Scenario Playbooks",
        "icon": "compass",
        "pages": [
          "scenarios/index"
        ]
      },
      {
        "group": "Auto Parser Scenarios",
        "icon": "wand-magic-sparkles",
        "pages": [
          "scenarios/auto-success",
          "scenarios/partial-event",
          "scenarios/mixed-events",
          "scenarios/unnamed-values",
          "scenarios/normalization",
          "scenarios/long-events",
          "scenarios/revisions",
          "scenarios/test-sender"
        ]
      },
      {
        "group": "ChatGPT Assisted Scenarios",
        "icon": "comments",
        "pages": [
          "scenarios/unknown-log",
          "scenarios/recipe-ai",
          "scenarios/ai-invalid-response",
          "scenarios/ai-test-change"
        ]
      },
      {
        "group": "Reference",
        "pages": [
          "reference/supported-formats",
          "reference/output-artifacts",
          "reference/source-privacy",
          "reference/troubleshooting",
          "reference/glossary",
          "reference/faq"
        ],
        "icon": "book-open"
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "XDR Labs",
        "href": "https://xdr.ooo"
      },
      {
        "type": "github",
        "href": "https://github.com/xdr-labs/parser-studio"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Start with logs",
      "href": "/quickstart"
    }
  },
  "search": {
    "prompt": "How do I analyze my logs?"
  },
  "appearance": {
    "default": "system",
    "strict": false
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://parser.xdr.ooo"
  },
  "favicon": "/favicon.svg",
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "seo": {
    "indexing": "navigable"
  },
  "metadata": {
    "timestamp": true
  },
  "redirects": [
    {
      "source": "/scenarios/first-firewall-json",
      "destination": "/scenarios/auto-success",
      "permanent": true
    },
    {
      "source": "/scenarios/csv-with-spec",
      "destination": "/scenarios/unnamed-values",
      "permanent": true
    },
    {
      "source": "/scenarios/multiline-java",
      "destination": "/scenarios/long-events",
      "permanent": true
    },
    {
      "source": "/scenarios/cef-leef",
      "destination": "/scenarios/auto-success",
      "permanent": true
    },
    {
      "source": "/scenarios/syslog-kv",
      "destination": "/scenarios/auto-success",
      "permanent": true
    },
    {
      "source": "/scenarios/panos-positional",
      "destination": "/scenarios/unnamed-values",
      "permanent": true
    }
  ]
}
